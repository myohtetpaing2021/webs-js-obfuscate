<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Luxxfits Budget Planner</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        
        :root {
            --primary: #8b5e3c;
            --primary-light: #a67c52;
            --bg-light: #fdfbf7;
            --card-light: #ffffff;
            --text-light: #2d241e;
            
            --bg-dark: #1a1614;
            --card-dark: #2d241e;
            --text-dark: #fdfbf7;
        }

        body {
            font-family: 'Inter', sans-serif;
            transition: background-color 0.3s, color 0.3s;
        }

        .dark {
            background-color: var(--bg-dark);
            color: var(--text-dark);
        }

        .light {
            background-color: var(--bg-light);
            color: var(--text-light);
        }

        .card {
            transition: transform 0.2s;
        }
        
        .dark .card {
            background-color: var(--card-dark);
            border: 1px solid #4a3f35;
        }
        
        .light .card {
            background-color: var(--card-light);
            border: 1px solid #e5e7eb;
        }

        .nav-item.active {
            background-color: var(--primary);
            color: white;
        }

        /* Wheel Chart Styles */
        .wheel-container {
            position: relative;
            width: 300px;
            height: 300px;
            margin: 0 auto;
        }
        
        .wheel-segment {
            cursor: pointer;
            transition: opacity 0.2s;
        }
        
        .wheel-segment:hover {
            opacity: 0.8;
        }

        /* Piggy Bank Grid */
        .piggy-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(40px, 1fr));
            gap: 10px;
        }
        
        .piggy-icon {
            width: 40px;
            height: 40px;
            cursor: pointer;
            transition: transform 0.2s;
        }
        
        .piggy-icon:hover {
            transform: scale(1.1);
        }

        .btn-primary {
            background-color: var(--primary);
            color: white;
        }
        
        .btn-primary:hover {
            background-color: var(--primary-light);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: var(--primary);
            border-radius: 4px;
        }
    </style>
</head>
<body class="light min-h-screen pb-20">
    <!-- Header -->
    <header class="sticky top-0 z-50 backdrop-blur-md border-b border-gray-200 dark:border-gray-700 p-4 flex justify-between items-center">
        <div class="flex items-center gap-2">
            <i data-lucide="wallet" class="text-[#8b5e3c]"></i>
            <h1 class="text-xl font-bold tracking-tight">Luxxfits <span class="font-light">Planner</span></h1>
        </div>
        <div class="flex items-center gap-4">
            <button id="themeToggle" class="p-2 rounded-full hover:bg-gray-200 dark:hover:bg-gray-800 transition-colors">
                <i data-lucide="moon" id="themeIcon"></i>
            </button>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-4xl mx-auto p-4 md:p-6" id="app">
        <!-- Content will be injected here -->
    </main>

    <!-- Bottom Navigation -->
    <nav class="fixed bottom-0 left-0 right-0 bg-white dark:bg-[#2d241e] border-t border-gray-200 dark:border-gray-700 px-2 py-3 flex justify-around items-center z-50">
        <button onclick="switchTab('dashboard')" class="nav-item flex flex-col items-center gap-1 px-3 py-1 rounded-lg transition-all" id="nav-dashboard">
            <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
            <span class="text-[10px] font-medium">Dashboard</span>
        </button>
        <button onclick="switchTab('daily')" class="nav-item flex flex-col items-center gap-1 px-3 py-1 rounded-lg transition-all" id="nav-daily">
            <i data-lucide="calendar-days" class="w-5 h-5"></i>
            <span class="text-[10px] font-medium">Daily</span>
        </button>
        <button onclick="switchTab('weekly')" class="nav-item flex flex-col items-center gap-1 px-3 py-1 rounded-lg transition-all" id="nav-weekly">
            <i data-lucide="calendar-range" class="w-5 h-5"></i>
            <span class="text-[10px] font-medium">Weekly</span>
        </button>
        <button onclick="switchTab('monthly')" class="nav-item flex flex-col items-center gap-1 px-3 py-1 rounded-lg transition-all" id="nav-monthly">
            <i data-lucide="pie-chart" class="w-5 h-5"></i>
            <span class="text-[10px] font-medium">Monthly</span>
        </button>
        <button onclick="switchTab('savings')" class="nav-item flex flex-col items-center gap-1 px-3 py-1 rounded-lg transition-all" id="nav-savings">
            <i data-lucide="piggy-bank" class="w-5 h-5"></i>
            <span class="text-[10px] font-medium">Savings</span>
        </button>
        <button onclick="switchTab('wheel')" class="nav-item flex flex-col items-center gap-1 px-3 py-1 rounded-lg transition-all" id="nav-wheel">
            <i data-lucide="refresh-cw" class="w-5 h-5"></i>
            <span class="text-[10px] font-medium">Wheel</span>
        </button>
    </nav>

    <script>
        // --- State Management ---
        let state = JSON.parse(localStorage.getItem('luxxfits_state')) || {
            theme: 'light',
            currentTab: 'dashboard',
            daily: {
                date: new Date().toISOString().split('T')[0],
                income: [],
                expenses: []
            },
            weekly: {
                target: 0,
                records: Array(7).fill({ income: 0, expense: 0 })
            },
            monthly: {
                targets: { housing: 0, food: 0, other: 0, extra: 0 },
                actuals: { housing: 0, food: 0, other: 0, extra: 0 }
            },
            savings: {
                goal: '',
                targetAmount: 0,
                currentAmount: 0,
                piggies: Array(50).fill(false)
            },
            wheel: Array(31).fill('none') // none, necessary, wants, no-spend
        };

        function saveState() {
            localStorage.setItem('luxxfits_state', JSON.stringify(state));
        }

        // --- Theme Logic ---
        const themeToggle = document.getElementById('themeToggle');
        const themeIcon = document.getElementById('themeIcon');
        
        function applyTheme() {
            if (state.theme === 'dark') {
                document.body.classList.remove('light');
                document.body.classList.add('dark');
                themeIcon.setAttribute('data-lucide', 'sun');
            } else {
                document.body.classList.remove('dark');
                document.body.classList.add('light');
                themeIcon.setAttribute('data-lucide', 'moon');
            }
            lucide.createIcons();
        }

        themeToggle.addEventListener('click', () => {
            state.theme = state.theme === 'light' ? 'dark' : 'light';
            saveState();
            applyTheme();
        });

        // --- Tab Navigation ---
        function switchTab(tabId) {
            state.currentTab = tabId;
            saveState();
            render();
        }

        function updateNav() {
            document.querySelectorAll('.nav-item').forEach(item => {
                item.classList.remove('active');
            });
            const activeNav = document.getElementById(`nav-${state.currentTab}`);
            if (activeNav) activeNav.classList.add('active');
        }

        // --- Rendering Logic ---
        const app = document.getElementById('app');

        function render() {
            updateNav();
            app.innerHTML = '';
            
            switch(state.currentTab) {
                case 'dashboard': renderDashboard(); break;
                case 'daily': renderDaily(); break;
                case 'weekly': renderWeekly(); break;
                case 'monthly': renderMonthly(); break;
                case 'savings': renderSavings(); break;
                case 'wheel': renderWheel(); break;
            }
            lucide.createIcons();
        }

        function renderDashboard() {
            const totalIncome = state.daily.income.reduce((sum, item) => sum + Number(item.amount), 0);
            const totalExpense = state.daily.expenses.reduce((sum, item) => sum + Number(item.amount), 0);
            const balance = totalIncome - totalExpense;

            app.innerHTML = `
                <div class="space-y-6">
                    <div class="flex justify-between items-end">
                        <div>
                            <p class="text-sm opacity-60">Welcome back,</p>
                            <h2 class="text-2xl font-bold">Financial Overview</h2>
                        </div>
                        <div class="text-right">
                            <p class="text-xs opacity-60">${new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="card p-6 rounded-2xl shadow-sm border-l-4 border-green-500">
                            <p class="text-xs font-medium uppercase tracking-wider opacity-60 mb-1">Total Income</p>
                            <p class="text-2xl font-bold text-green-600">$${totalIncome.toLocaleString()}</p>
                        </div>
                        <div class="card p-6 rounded-2xl shadow-sm border-l-4 border-red-500">
                            <p class="text-xs font-medium uppercase tracking-wider opacity-60 mb-1">Total Expenses</p>
                            <p class="text-2xl font-bold text-red-600">$${totalExpense.toLocaleString()}</p>
                        </div>
                        <div class="card p-6 rounded-2xl shadow-sm border-l-4 border-[#8b5e3c]">
                            <p class="text-xs font-medium uppercase tracking-wider opacity-60 mb-1">Net Balance</p>
                            <p class="text-2xl font-bold ${balance >= 0 ? 'text-blue-600' : 'text-orange-600'}">$${balance.toLocaleString()}</p>
                        </div>
                    </div>

                    <div class="card p-6 rounded-2xl shadow-sm">
                        <h3 class="font-bold mb-4 flex items-center gap-2">
                            <i data-lucide="trending-up" class="w-4 h-4"></i>
                            Recent Activity
                        </h3>
                        <div class="space-y-3">
                            ${[...state.daily.income, ...state.daily.expenses].length === 0 ? 
                                '<p class="text-center py-8 opacity-40 italic">No transactions recorded today.</p>' : 
                                [...state.daily.income, ...state.daily.expenses].slice(-5).reverse().map(item => `
                                    <div class="flex justify-between items-center p-3 rounded-xl bg-gray-50 dark:bg-black/20">
                                        <div class="flex items-center gap-3">
                                            <div class="p-2 rounded-full ${state.daily.income.includes(item) ? 'bg-green-100 text-green-600' : 'bg-red-100 text-red-600'}">
                                                <i data-lucide="${state.daily.income.includes(item) ? 'arrow-down-left' : 'arrow-up-right'}" class="w-4 h-4"></i>
                                            </div>
                                            <div>
                                                <p class="font-medium text-sm">${item.desc}</p>
                                                <p class="text-[10px] opacity-50">${state.daily.date}</p>
                                            </div>
                                        </div>
                                        <p class="font-bold ${state.daily.income.includes(item) ? 'text-green-600' : 'text-red-600'}">
                                            ${state.daily.income.includes(item) ? '+' : '-'}$${Number(item.amount).toLocaleString()}
                                        </p>
                                    </div>
                                `).join('')
                            }
                        </div>
                    </div>
                </div>
            `;
        }

        function renderDaily() {
            app.innerHTML = `
                <div class="space-y-6">
                    <div class="flex justify-between items-center">
                        <h2 class="text-2xl font-bold">Daily Record</h2>
                        <input type="date" value="${state.daily.date}" onchange="updateDailyDate(this.value)" class="bg-transparent border-b border-[#8b5e3c] focus:outline-none text-sm">
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Income Section -->
                        <div class="card p-5 rounded-2xl shadow-sm">
                            <div class="flex justify-between items-center mb-4">
                                <h3 class="font-bold text-green-600 flex items-center gap-2">
                                    <i data-lucide="plus-circle" class="w-4 h-4"></i>
                                    Income (ဝင်ငွေ)
                                </h3>
                                <button onclick="addDailyItem('income')" class="text-xs bg-green-100 text-green-700 px-2 py-1 rounded-md hover:bg-green-200 transition-colors">Add New</button>
                            </div>
                            <div class="space-y-2 max-h-[300px] overflow-y-auto pr-2">
                                ${state.daily.income.map((item, index) => `
                                    <div class="flex gap-2 items-center">
                                        <input type="text" placeholder="Description" value="${item.desc}" onchange="editDailyItem('income', ${index}, 'desc', this.value)" class="flex-1 bg-gray-50 dark:bg-black/20 p-2 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-green-500">
                                        <input type="number" placeholder="Amount" value="${item.amount}" onchange="editDailyItem('income', ${index}, 'amount', this.value)" class="w-24 bg-gray-50 dark:bg-black/20 p-2 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-green-500">
                                        <button onclick="removeDailyItem('income', ${index})" class="text-red-400 hover:text-red-600"><i data-lucide="x" class="w-4 h-4"></i></button>
                                    </div>
                                `).join('')}
                            </div>
                            <div class="mt-4 pt-4 border-t border-dashed border-gray-200 dark:border-gray-700 flex justify-between font-bold">
                                <span>Total Income:</span>
                                <span class="text-green-600">$${state.daily.income.reduce((sum, i) => sum + Number(i.amount), 0).toLocaleString()}</span>
                            </div>
                        </div>

                        <!-- Expense Section -->
                        <div class="card p-5 rounded-2xl shadow-sm">
                            <div class="flex justify-between items-center mb-4">
                                <h3 class="font-bold text-red-600 flex items-center gap-2">
                                    <i data-lucide="minus-circle" class="w-4 h-4"></i>
                                    Expenses (ထွက်ငွေ)
                                </h3>
                                <button onclick="addDailyItem('expenses')" class="text-xs bg-red-100 text-red-700 px-2 py-1 rounded-md hover:bg-red-200 transition-colors">Add New</button>
                            </div>
                            <div class="space-y-2 max-h-[300px] overflow-y-auto pr-2">
                                ${state.daily.expenses.map((item, index) => `
                                    <div class="flex gap-2 items-center">
                                        <input type="text" placeholder="Description" value="${item.desc}" onchange="editDailyItem('expenses', ${index}, 'desc', this.value)" class="flex-1 bg-gray-50 dark:bg-black/20 p-2 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-red-500">
                                        <input type="number" placeholder="Amount" value="${item.amount}" onchange="editDailyItem('expenses', ${index}, 'amount', this.value)" class="w-24 bg-gray-50 dark:bg-black/20 p-2 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-red-500">
                                        <button onclick="removeDailyItem('expenses', ${index})" class="text-red-400 hover:text-red-600"><i data-lucide="x" class="w-4 h-4"></i></button>
                                    </div>
                                `).join('')}
                            </div>
                            <div class="mt-4 pt-4 border-t border-dashed border-gray-200 dark:border-gray-700 flex justify-between font-bold">
                                <span>Total Expenses:</span>
                                <span class="text-red-600">$${state.daily.expenses.reduce((sum, i) => sum + Number(i.amount), 0).toLocaleString()}</span>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }

        function updateDailyDate(val) { state.daily.date = val; saveState(); }
        function addDailyItem(type) { state.daily[type].push({ desc: '', amount: 0 }); saveState(); render(); }
        function editDailyItem(type, index, field, val) { state.daily[type][index][field] = val; saveState(); }
        function removeDailyItem(type, index) { state.daily[type].splice(index, 1); saveState(); render(); }

        function renderWeekly() {
            const days = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
            const totalIncome = state.weekly.records.reduce((sum, r) => sum + Number(r.income), 0);
            const totalExpense = state.weekly.records.reduce((sum, r) => sum + Number(r.expense), 0);
            const diff = state.weekly.target - totalExpense;

            app.innerHTML = `
                <div class="space-y-6">
                    <h2 class="text-2xl font-bold">Weekly Record</h2>
                    
                    <div class="card p-6 rounded-2xl shadow-sm">
                        <div class="grid grid-cols-3 gap-4 mb-6">
                            <div class="text-center">
                                <p class="text-[10px] uppercase opacity-50">Spending Target</p>
                                <input type="number" value="${state.weekly.target}" onchange="state.weekly.target = this.value; saveState(); render();" class="w-full text-center bg-transparent font-bold text-lg focus:outline-none">
                            </div>
                            <div class="text-center">
                                <p class="text-[10px] uppercase opacity-50">Actual Spent</p>
                                <p class="font-bold text-lg text-red-600">$${totalExpense.toLocaleString()}</p>
                            </div>
                            <div class="text-center">
                                <p class="text-[10px] uppercase opacity-50">Difference</p>
                                <p class="font-bold text-lg ${diff >= 0 ? 'text-green-600' : 'text-orange-600'}">$${diff.toLocaleString()}</p>
                            </div>
                        </div>

                        <div class="overflow-x-auto">
                            <table class="w-full text-sm">
                                <thead>
                                    <tr class="border-b border-gray-100 dark:border-gray-800">
                                        <th class="text-left py-3 font-medium opacity-60">Day</th>
                                        <th class="text-right py-3 font-medium opacity-60">Income</th>
                                        <th class="text-right py-3 font-medium opacity-60">Expense</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    ${days.map((day, i) => `
                                        <tr class="border-b border-gray-50 dark:border-gray-800/50">
                                            <td class="py-3 font-medium">${day}</td>
                                            <td class="py-3"><input type="number" value="${state.weekly.records[i].income}" onchange="state.weekly.records[${i}].income = this.value; saveState(); render();" class="w-full text-right bg-transparent focus:outline-none text-green-600"></td>
                                            <td class="py-3"><input type="number" value="${state.weekly.records[i].expense}" onchange="state.weekly.records[${i}].expense = this.value; saveState(); render();" class="w-full text-right bg-transparent focus:outline-none text-red-600"></td>
                                        </tr>
                                    `).join('')}
                                </tbody>
                                <tfoot>
                                    <tr class="font-bold">
                                        <td class="py-4">TOTAL</td>
                                        <td class="py-4 text-right text-green-600">$${totalIncome.toLocaleString()}</td>
                                        <td class="py-4 text-right text-red-600">$${totalExpense.toLocaleString()}</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            `;
        }

        function renderMonthly() {
            const categories = [
                { id: 'housing', label: 'Housing (အိမ်စရိတ်)', icon: 'home' },
                { id: 'food', label: 'Food (စားစရိတ်)', icon: 'utensils' },
                { id: 'other', label: 'Other (အထွေထွေ)', icon: 'shopping-bag' },
                { id: 'extra', label: 'Extra (အပိုအသုံး)', icon: 'star' }
            ];

            app.innerHTML = `
                <div class="space-y-6">
                    <h2 class="text-2xl font-bold">Monthly Portfolio</h2>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        ${categories.map(cat => {
                            const target = state.monthly.targets[cat.id];
                            const actual = state.monthly.actuals[cat.id];
                            const percent = target > 0 ? Math.min((actual / target) * 100, 100) : 0;
                            const color = percent > 90 ? 'bg-red-500' : percent > 70 ? 'bg-orange-500' : 'bg-[#8b5e3c]';

                            return `
                                <div class="card p-5 rounded-2xl shadow-sm">
                                    <div class="flex items-center gap-3 mb-4">
                                        <div class="p-2 rounded-xl bg-[#8b5e3c]/10 text-[#8b5e3c]">
                                            <i data-lucide="${cat.icon}" class="w-5 h-5"></i>
                                        </div>
                                        <h3 class="font-bold">${cat.label}</h3>
                                    </div>
                                    
                                    <div class="grid grid-cols-2 gap-4 mb-4">
                                        <div>
                                            <p class="text-[10px] uppercase opacity-50">Target</p>
                                            <input type="number" value="${target}" onchange="state.monthly.targets.${cat.id} = this.value; saveState(); render();" class="w-full bg-transparent font-bold text-lg focus:outline-none">
                                        </div>
                                        <div>
                                            <p class="text-[10px] uppercase opacity-50">Spent</p>
                                            <input type="number" value="${actual}" onchange="state.monthly.actuals.${cat.id} = this.value; saveState(); render();" class="w-full bg-transparent font-bold text-lg focus:outline-none text-red-600">
                                        </div>
                                    </div>

                                    <div class="w-full bg-gray-100 dark:bg-black/40 h-2 rounded-full overflow-hidden">
                                        <div class="h-full ${color} transition-all duration-500" style="width: ${percent}%"></div>
                                    </div>
                                    <p class="text-right text-[10px] mt-1 opacity-50">${Math.round(percent)}% of budget used</p>
                                </div>
                            `;
                        }).join('')}
                    </div>

                    <div class="card p-6 rounded-2xl shadow-sm bg-[#8b5e3c] text-white">
                        <h3 class="font-bold mb-4">Monthly Summary</h3>
                        <div class="grid grid-cols-3 gap-4 text-center">
                            <div>
                                <p class="text-[10px] uppercase opacity-80">Total Savings</p>
                                <p class="text-xl font-bold">$${(Object.values(state.monthly.targets).reduce((a,b)=>Number(a)+Number(b),0) - Object.values(state.monthly.actuals).reduce((a,b)=>Number(a)+Number(b),0)).toLocaleString()}</p>
                            </div>
                            <div>
                                <p class="text-[10px] uppercase opacity-80">Total Spent</p>
                                <p class="text-xl font-bold">$${Object.values(state.monthly.actuals).reduce((a,b)=>Number(a)+Number(b),0).toLocaleString()}</p>
                            </div>
                            <div>
                                <p class="text-[10px] uppercase opacity-80">Efficiency</p>
                                <p class="text-xl font-bold">84%</p>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }

        function renderSavings() {
            const filledCount = state.savings.piggies.filter(p => p).length;
            const progress = (filledCount / state.savings.piggies.length) * 100;

            app.innerHTML = `
                <div class="space-y-6">
                    <h2 class="text-2xl font-bold">Savings Tracker</h2>
                    
                    <div class="card p-6 rounded-2xl shadow-sm text-center">
                        <div class="mb-6">
                            <p class="text-xs uppercase opacity-50 mb-1">My Savings Goal</p>
                            <input type="text" placeholder="What are you saving for?" value="${state.savings.goal}" onchange="state.savings.goal = this.value; saveState();" class="w-full text-center bg-transparent font-bold text-xl focus:outline-none border-b border-dashed border-[#8b5e3c]/30 pb-2">
                        </div>

                        <div class="flex justify-center gap-8 mb-8">
                            <div>
                                <p class="text-[10px] uppercase opacity-50">Target Amount</p>
                                <input type="number" value="${state.savings.targetAmount}" onchange="state.savings.targetAmount = this.value; saveState(); render();" class="w-24 text-center bg-transparent font-bold text-lg focus:outline-none">
                            </div>
                            <div>
                                <p class="text-[10px] uppercase opacity-50">Saved So Far</p>
                                <p class="font-bold text-lg text-green-600">$${((state.savings.targetAmount / 50) * filledCount).toLocaleString()}</p>
                            </div>
                        </div>

                        <div class="piggy-grid mb-6">
                            ${state.savings.piggies.map((filled, i) => `
                                <div onclick="togglePiggy(${i})" class="piggy-icon flex items-center justify-center rounded-lg ${filled ? 'bg-orange-100 text-orange-500' : 'bg-gray-100 dark:bg-black/20 text-gray-300'}">
                                    <i data-lucide="piggy-bank" class="w-6 h-6"></i>
                                </div>
                            `).join('')}
                        </div>

                        <div class="w-full bg-gray-100 dark:bg-black/40 h-3 rounded-full overflow-hidden">
                            <div class="h-full bg-orange-500 transition-all duration-500" style="width: ${progress}%"></div>
                        </div>
                        <p class="text-sm mt-2 opacity-60">${filledCount} of 50 steps completed (${Math.round(progress)}%)</p>
                    </div>
                </div>
            `;
        }

        function togglePiggy(i) {
            state.savings.piggies[i] = !state.savings.piggies[i];
            saveState();
            render();
        }

        function renderWheel() {
            app.innerHTML = `
                <div class="space-y-6">
                    <h2 class="text-2xl font-bold">Expense Habit Wheel</h2>
                    
                    <div class="card p-8 rounded-2xl shadow-sm flex flex-col items-center">
                        <div class="wheel-container mb-8">
                            <svg viewBox="0 0 100 100" class="w-full h-full transform -rotate-90">
                                ${state.wheel.map((type, i) => {
                                    const startAngle = (i * 360) / 31;
                                    const endAngle = ((i + 1) * 360) / 31;
                                    const x1 = 50 + 45 * Math.cos((Math.PI * startAngle) / 180);
                                    const y1 = 50 + 45 * Math.sin((Math.PI * startAngle) / 180);
                                    const x2 = 50 + 45 * Math.cos((Math.PI * endAngle) / 180);
                                    const y2 = 50 + 45 * Math.sin((Math.PI * endAngle) / 180);
                                    
                                    let color = '#e5e7eb'; // none
                                    if (type === 'necessary') color = '#8b5e3c';
                                    if (type === 'wants') color = '#f97316';
                                    if (type === 'no-spend') color = '#22c55e';

                                    return `
                                        <path d="M 50 50 L ${x1} ${y1} A 45 45 0 0 1 ${x2} ${y2} Z" 
                                              fill="${color}" 
                                              stroke="white" 
                                              stroke-width="0.5"
                                              class="wheel-segment"
                                              onclick="cycleWheelDay(${i})">
                                            <title>Day ${i+1}: ${type}</title>
                                        </path>
                                    `;
                                }).join('')}
                                <circle cx="50" cy="50" r="20" fill="white" class="dark:fill-[#2d241e]" />
                                <text x="50" y="55" text-anchor="middle" class="text-[8px] font-bold fill-current">MAY</text>
                            </svg>
                        </div>

                        <div class="grid grid-cols-2 gap-4 w-full max-w-xs">
                            <div class="flex items-center gap-2">
                                <div class="w-3 h-3 rounded-full bg-[#8b5e3c]"></div>
                                <span class="text-xs">Necessary (လိုအပ်ချက်)</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <div class="w-3 h-3 rounded-full bg-orange-500"></div>
                                <span class="text-xs">Wants (အလိုဆန္ဒ)</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <div class="w-3 h-3 rounded-full bg-green-500"></div>
                                <span class="text-xs">No Spend (မသုံးဖြစ်သောနေ့)</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <div class="w-3 h-3 rounded-full bg-gray-200"></div>
                                <span class="text-xs">Not Recorded</span>
                            </div>
                        </div>
                        
                        <p class="mt-6 text-xs opacity-50 italic text-center">Tap a segment of the wheel to cycle through spending habits for each day of the month.</p>
                    </div>
                </div>
            `;
        }

        function cycleWheelDay(i) {
            const types = ['none', 'necessary', 'wants', 'no-spend'];
            const currentIdx = types.indexOf(state.wheel[i]);
            state.wheel[i] = types[(currentIdx + 1) % types.length];
            saveState();
            render();
        }

        // Initial Render
        applyTheme();
        render();
    </script>
</body>
</html>
